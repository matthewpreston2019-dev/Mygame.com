# ──────────────────────────────────────────────────────────────────────────────
# Lumora environment variables
# Copy to `.env` for local development (`netlify dev` loads it automatically),
# and add the same keys in Netlify → Site configuration → Environment variables.
# NEVER commit real keys. None of these are exposed to the browser except the
# Supabase URL + anon key, which Supabase designs to be public.
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME=Lumora

# ── AI providers (configure at least ONE) ─────────────────────────────────────
# Paid APIs (pay-per-token):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Free tiers available (rate-limited):
GOOGLE_AI_API_KEY=          # Google AI Studio (Gemini) — has a free tier
OPENROUTER_API_KEY=         # OpenRouter — many models, some ":free" ones
GROQ_API_KEY=               # Groq — free tier; also enables voice transcription
# Any other OpenAI-compatible API (Together, Mistral, DeepSeek, LM Studio, vLLM...):
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_NAME=Custom
CUSTOM_OPENAI_MODELS=       # optional comma list if the API has no /models endpoint
# Local models with Ollama (works with `netlify dev`; production needs a publicly reachable URL):
OLLAMA_BASE_URL=            # e.g. http://localhost:11434

# Order used for automatic model choice and fallback (comma list of provider ids):
# PROVIDER_PRIORITY=anthropic,openai,gemini,openrouter,groq,custom,ollama
# PROVIDER_FALLBACK=true

# Optional explicit routing targets, format "provider:model" (otherwise picked from live model lists):
# MODEL_FAST=gemini:gemini-2.5-flash-lite
# MODEL_BALANCED=anthropic:claude-sonnet-5-5
# MODEL_POWERFUL=anthropic:claude-opus-5-5
# MODEL_VISION=
# MODEL_LONG_CONTEXT=
# ROUTER_STRATEGY=heuristic   # or "llm" to let the fast model classify ambiguous requests

# ── Web search (optional; enables the web_search tool) ────────────────────────
SEARCH_PROVIDER=            # tavily | brave | searxng
SEARCH_API_KEY=             # Tavily or Brave key
SEARXNG_URL=                # your SearXNG instance (JSON format enabled) — free/self-hosted

# ── Authentication (choose one) ───────────────────────────────────────────────
# Option A — Supabase (multi-device sync, email/password + OAuth, free tier):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_OAUTH_PROVIDERS=   # e.g. google,github (enable them in Supabase first)
ALLOWED_EMAILS=             # REQUIRED allow-list, e.g. you@example.com
ADMIN_EMAILS=               # who sees the admin panel (defaults to ALLOWED_EMAILS)
# OPEN_SIGNUPS=true         # allow anyone who signs up (not recommended)
#
# Option B — single owner password (data stays in your browser):
APP_PASSWORD=
SESSION_SECRET=             # long random string, e.g. `openssl rand -hex 32`
#
# AUTH_MODE=                # force: supabase | password | none  (none = NO auth; local only!)
# ALLOWED_ORIGINS=          # extra origins allowed to call the API (comma list)

# ── Cost control & limits ─────────────────────────────────────────────────────
MAX_OUTPUT_TOKENS=8192
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_LIMIT=500
DAILY_TOKEN_BUDGET=0        # 0 = unlimited; e.g. 2000000
MAX_FILE_BYTES=10000000
MAX_FILES_PER_MESSAGE=8
MAX_REQUEST_BYTES=4500000   # Netlify functions accept ~6 MB request bodies
MAX_INPUT_CHARS=600000
MAX_AGENT_STEPS=8
PROVIDER_TIMEOUT_MS=55000

# Voice transcription fallback (optional): uses GROQ_API_KEY or OPENAI_API_KEY
# TRANSCRIPTION_PROVIDER=groq
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
