# ── Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Access ──────────────────────────────────────────────
# Required whenever the server is reachable from the internet.
# Use a long random string; you type it once on each device.
FACTORY_TOKEN=change-me-to-a-long-random-string

# ── Server ──────────────────────────────────────────────
PORT=8787
# 127.0.0.1 = this computer only. Use 0.0.0.0 on a cloud host.
HOST=127.0.0.1
# Where tasks, results and learned skills are stored.
DATA_DIR=data
# Schedules (e.g. the daily briefing) use this time zone.
TZ=Europe/London

# ── Spending & limits ───────────────────────────────────
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=30
MAX_PARALLEL=3
BRIEFING_AT=08:00
# Reuse identical completed work for this many days instead of paying again.
REUSE_DAYS=7

# ── Models (economical → strong) ────────────────────────
MODEL_FAST=claude-haiku-5-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_STRONG=claude-opus-5-5

# ── Skills ──────────────────────────────────────────────
# Comma-separated HTTPS URLs of skill index files you trust (see README).
TRUSTED_SKILL_SOURCES=

# Run without an API key using simulated output (clearly labelled).
FACTORY_DEMO=0
